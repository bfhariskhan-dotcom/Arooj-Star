{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Architectural paint formulation in the Arooj Star catalog.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "code": { "type": "string", "maxLength": 40 },
        "name": { "type": "string", "maxLength": 200 },
        "brand": { "type": "string", "maxLength": 80 },
        "category": {
          "type": "string",
          "enum": ["exterior", "interior", "enamels", "putties", "primers", "wood"]
        },
        "categoryLabel": { "type": "string", "maxLength": 120 },
        "baseType": { "type": "string", "maxLength": 80 },
        "baseCategoryCode": { "type": "string", "enum": ["WB", "OB", "VR"] },
        "shortDesc": { "type": "string", "maxLength": 400 },
        "fullDesc": { "type": "string", "maxLength": 2000 },
        "coverageSqFt": { "type": "string", "maxLength": 120 },
        "dryingTime": { "type": "string", "maxLength": 120 },
        "finish": { "type": "string", "maxLength": 80 },
        "defaultSize": { "type": "string", "maxLength": 40 },
        "popular": { "type": "boolean" },
        "active": { "type": "boolean" },
        "order": { "type": "number" },
        "image": { "type": "string", "maxLength": 1000 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "code", "name", "category", "baseCategoryCode", "prices", "defaultSize"]
    },
    "Quotation": {
      "title": "Quotation",
      "description": "Dealer quotation request or inquiry submitted from the storefront.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "orderNumber": { "type": "string", "maxLength": 40 },
        "source": { "type": "string", "enum": ["quotation_drawer", "contact_form"] },
        "fullName": { "type": "string", "maxLength": 120 },
        "companyShopName": { "type": "string", "maxLength": 160 },
        "phone": { "type": "string", "maxLength": 40 },
        "city": { "type": "string", "maxLength": 100 },
        "province": { "type": "string", "maxLength": 100 },
        "deliveryAddress": { "type": "string", "maxLength": 400 },
        "orderNotes": { "type": "string", "maxLength": 1000 },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["new", "contacted", "dispatched", "completed"] },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "fullName", "phone", "status", "createdAt"]
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Global storefront brand, contact, and media configuration.",
      "type": "object",
      "properties": {
        "brandName": { "type": "string", "maxLength": 120 },
        "galleryName": { "type": "string", "maxLength": 160 },
        "parentIndustry": { "type": "string", "maxLength": 160 },
        "taglineEnglish": { "type": "string", "maxLength": 300 },
        "ceo": { "type": "string", "maxLength": 120 },
        "contactPerson": { "type": "string", "maxLength": 120 },
        "phone1": { "type": "string", "maxLength": 40 },
        "phone1Raw": { "type": "string", "maxLength": 40 },
        "phone2": { "type": "string", "maxLength": 40 },
        "phone2Raw": { "type": "string", "maxLength": 40 },
        "email": { "type": "string", "maxLength": 160 },
        "website": { "type": "string", "maxLength": 300 },
        "domain": { "type": "string", "maxLength": 160 },
        "priceListDate": { "type": "string", "maxLength": 120 },
        "address": { "type": "string", "maxLength": 300 },
        "heroImage": { "type": "string", "maxLength": 1000 },
        "aboutImage": { "type": "string", "maxLength": 1000 },
        "socialLinks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "platform": { "type": "string" },
              "label": { "type": "string" },
              "url": { "type": "string" },
              "enabled": { "type": "boolean" }
            }
          }
        }
      },
      "required": ["brandName", "galleryName", "email", "website"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Official Arooj Star paint formulations catalog."
    },
    "/quotations/{quotationId}": {
      "schema": { "$ref": "#/entities/Quotation" },
      "description": "Submitted dealer quotations and contact inquiries."
    },
    "/siteConfig/{configId}": {
      "schema": { "$ref": "#/entities/SiteSettings" },
      "description": "Global site settings and media URLs."
    }
  }
}
